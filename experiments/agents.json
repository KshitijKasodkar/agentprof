{
 "ref-gemini": {
  "needs": "GEMINI_API_KEY (free key from https://aistudio.google.com/apikey); OpenAI-compatible endpoint",
  "model": "gemini-3.8-flash",
  "cmd": [
   "python3",
   "{root}/tools/ref_agent.py",
   "--base",
   "https://generativelanguage.googleapis.com/v1beta/openai",
   "--model",
   "{model}",
   "--key-env",
   "GEMINI_API_KEY",
   "--task",
   "{prompt}",
   "--log",
   "{run}/ref_agent_truth.jsonl",
   "--max-steps",
   "25"
  ],
  "env_passthrough": [
   "GEMINI_API_KEY"
  ]
 },
 "gemini-cli": {
  "needs": "Node >= 20, npm i -g @google/gemini-cli; GEMINI_API_KEY. --skip-trust trusts only the throw-away task folder for that run; --allowed-tools must be repeated per command",
  "model": "gemini-3.5-flash-lite",
  "cmd": [
   "gemini",
   "-m",
   "{model}",
   "-p",
   "{prompt}",
   "--skip-trust",
   "--approval-mode",
   "auto_edit",
   "-o",
   "json",
   "--allowed-tools",
   "run_shell_command(python3)",
   "--allowed-tools",
   "run_shell_command(make)",
   "--allowed-tools",
   "run_shell_command(cc)",
   "--allowed-tools",
   "run_shell_command(gcc)",
   "--allowed-tools",
   "run_shell_command(./primes)",
   "--allowed-tools",
   "run_shell_command(git status)",
   "--allowed-tools",
   "run_shell_command(git diff)",
   "--allowed-tools",
   "run_shell_command(git add)",
   "--allowed-tools",
   "run_shell_command(git commit)",
   "--allowed-tools",
   "run_shell_command(git log)",
   "--allowed-tools",
   "run_shell_command(ls)",
   "--allowed-tools",
   "run_shell_command(cat)",
   "--allowed-tools",
   "run_shell_command(grep)",
   "--allowed-tools",
   "run_shell_command(awk)",
   "--allowed-tools",
   "run_shell_command(sort)",
   "--allowed-tools",
   "run_shell_command(uniq)",
   "--allowed-tools",
   "run_shell_command(head)",
   "--allowed-tools",
   "run_shell_command(wc)",
   "--allowed-tools",
   "run_shell_command(.venv/bin/pip)",
   "--allowed-tools",
   "run_shell_command(.venv/bin/python)"
  ],
  "env_passthrough": [
   "GEMINI_API_KEY"
  ]
 }
}